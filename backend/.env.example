NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://gym_app:Learn@123@localhost:5432/gym_db
DB_SSL=false
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_of_32_plus_chars
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
GYM_NAME=My Gym

# Used only by `npm run seed:owner`
OWNER_NAME=Abhi
OWNER_EMAIL=abhirajwork073@gmail.com
OWNER_PASSWORD=123456

# Email (any SMTP provider). Leave SMTP_HOST empty to disable sending (reminders are logged as failed).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="My Gym <no-reply@example.com>"

# Reminders
ENABLE_CRON=false
REMINDER_CRON=0 9 * * *
# Shared secret for an external scheduler to call POST /api/jobs/run-reminders (leave empty to disable)
JOB_SECRET=
